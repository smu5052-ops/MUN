/* 저장 코드 */
function exportCode(){
  const parts=[];
  CHARACTERS.forEach((c,ci)=>GRADES.forEach((g,gi)=>{
    const vm=S.vars[c.id+':'+g.k];if(!vm)return;
    const arr=[];let last=-1;
    for(let v=0;v<imgsOf(c).length;v++){arr.push(vm[v]||0);if(vm[v])last=v}
    if(last>=0)parts.push(ci+':'+gi+':'+arr.slice(0,last+1).join(','));
  }));
  return S.pid+'-K1-'+parts.join(';');
}
function importCode(code){
  const t=String(code).trim();
  const m=t.match(/^(?:(\d{6}|\d{8})-)?K1-([0-9:,;]*)$/);
  if(!m)throw new Error('format');
  const vars={},inv={},lastv={};let used=0;
  m[2].split(';').filter(Boolean).forEach(e=>{
    if(!/^\d+:\d+:\d+(,\d+)*$/.test(e))throw new Error('entry');
    const [ci,gi,cs]=e.split(':'),c=CHARACTERS[+ci],g=GRADES[+gi];
    if(!c||!g)throw new Error('index');
    const vm={};let sum=0,last=0;
    cs.split(',').forEach((x,v)=>{
      const n=Number(x);
      if(!(n<1e6)||v>=imgsOf(c).length)throw new Error('count');
      if(n){vm[v]=n;sum+=n;last=v}
    });
    if(!sum)return;
    const key=c.id+':'+g.k;
    vars[key]=vm;inv[key]=sum;lastv[key]=last;used+=sum;
  });
  return {pid:m[1],used,inv,vars,lastv};
}
async function copyText(t,el){
  try{await navigator.clipboard.writeText(t);toast('복사했어요')}
  catch(e){el.focus();el.select();toast('선택됐어요. 길게 눌러 복사하세요')}
}
