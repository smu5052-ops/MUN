const GRADES=[
  {k:'F',  p:451,c1:'#8b929e',c2:'#4b505b'},
  {k:'E',  p:250,c1:'#5fae7e',c2:'#2c6b4a'},
  {k:'D',  p:130,c1:'#5b9bd6',c2:'#28558a'},
  {k:'C',  p:70, c1:'#35bcc0',c2:'#166a70'},
  {k:'B',  p:40, c1:'#9a86e0',c2:'#4f3d99'},
  {k:'A',  p:25, c1:'#f09a3c',c2:'#a4531a'},
  {k:'AA', p:15, c1:'#e5584f',c2:'#8c1f27'},
  {k:'S',  p:10, c1:'#f4c740',c2:'#a8731a'},
  {k:'SS', p:6,  c1:'#ee4f9d',c2:'#7a1f66'},
