<!doctype html>
<html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<style>:root{color-scheme:light dark}html,body{margin:0}body{font-size:14px}img{max-width:100%}[hidden]{display:none!important}</style>
<title>초카구야공주! 카드 뽑기</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=IBM+Plex+Mono:wght@500;600&family=IBM+Plex+Sans+KR:wght@400;500;600;700&display=swap">
<style>
/* 레이아웃: 상단 고정 바(제목 + 남은 뽑기)와 탭 3개. 뽑기 탭은 넓은 화면에서 2단(카드 무대 | 활동·확률). */
:root{
  --bg:#e9ecf1; --surface:#ffffff; --surface-2:#f1f3f7; --fg:#12151c; --muted:#596074; --line:#d3d8e2;
  --accent:#2457e6; --accent-fg:#ffffff; --danger:#c43a2f; --overlay:rgba(8,10,16,.74); --on-overlay:#ffffff;
  --g-F:#8b929e;  --gt-F:#ffffff;
  --g-E:#4c9a6a;  --gt-E:#ffffff;
  --g-D:#3f86c7;  --gt-D:#ffffff;
  --g-C:#2fb3b8;  --gt-C:#06211f;
  --g-B:#8a74da;  --gt-B:#ffffff;
  --g-A:#ee933a;  --gt-A:#2a1403;
  --g-AA:#dc4a42; --gt-AA:#ffffff;
  --g-S:#f2c13a;  --gt-S:#2a1f02;
  --g-SS:#e8438f; --gt-SS:#ffffff;
  --g-SSS:#ffc83d;--gt-SSS:#16120a;
  --gbg-SSS:linear-gradient(120deg,#ffd24a,#ff6fb0 50%,#5fd0ff);
  --g-Ω:#9b4dff;--gt-Ω:#ffffff;
  --gbg-Ω:linear-gradient(120deg,#1b0a45,#7a2cff 40%,#ff3d86 72%,#ffd24a);
  --font-display:'Black Han Sans','Apple SD Gothic Neo','Malgun Gothic',sans-serif;
  --font-body:'IBM Plex Sans KR','Apple SD Gothic Neo','Malgun Gothic',system-ui,sans-serif;
  --font-mono:'IBM Plex Mono',ui-monospace,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0d1017; --surface:#161a24; --surface-2:#1e2331; --fg:#e9ecf5; --muted:#97a0b6; --line:#2a3043;
    --accent:#7ba0ff; --accent-fg:#0a0f1e; --danger:#ff7a6e; color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0d1017; --surface:#161a24; --surface-2:#1e2331; --fg:#e9ecf5; --muted:#97a0b6; --line:#2a3043;
  --accent:#7ba0ff; --accent-fg:#0a0f1e; --danger:#ff7a6e; color-scheme:dark;
}

*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font-family:var(--font-body);font-size:15px;line-height:1.5;padding-inline:16px;padding-block:0 56px}
button,input,select,textarea{font:inherit}
.app{max-width:980px;margin-inline:auto}
.mono{font-family:var(--font-mono);font-variant-numeric:tabular-nums}

/* 등급 색 */
.g-F{--gc:var(--g-F);--gt:var(--gt-F)}
.g-E{--gc:var(--g-E);--gt:var(--gt-E)}
.g-D{--gc:var(--g-D);--gt:var(--gt-D)}
.g-C{--gc:var(--g-C);--gt:var(--gt-C)}
.g-B{--gc:var(--g-B);--gt:var(--gt-B)}
.g-A{--gc:var(--g-A);--gt:var(--gt-A)}
.g-AA{--gc:var(--g-AA);--gt:var(--gt-AA)}
.g-S{--gc:var(--g-S);--gt:var(--gt-S)}
.g-SS{--gc:var(--g-SS);--gt:var(--gt-SS)}
.g-SSS{--gc:var(--g-SSS);--gt:var(--gt-SSS);--gbg:var(--gbg-SSS)}
.g-Ω{--gc:var(--g-Ω);--gt:var(--gt-Ω);--gbg:var(--gbg-Ω)}
.gchip{display:inline-grid;place-items:center;min-width:40px;padding:1px 8px;border-radius:6px;font-family:var(--font-display);font-size:14px;line-height:1.5;background:var(--gbg,var(--gc));color:var(--gt)}

/* 상단 바 */
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:10;background:var(--bg);margin-inline:-16px;padding-inline:16px;border-bottom:1px solid var(--line)}
.bar-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-block:14px 6px}
h1{font-family:var(--font-display);font-weight:400;font-size:24px;line-height:1.15;margin:0;letter-spacing:-.01em;text-wrap:balance}
.chip{display:inline-flex;align-items:baseline;gap:8px;padding:6px 14px;border-radius:999px;background:var(--accent);color:var(--accent-fg);font-weight:600;font-size:13px;white-space:nowrap}
.chip b{font-family:var(--font-mono);font-size:18px;font-variant-numeric:tabular-nums}
.chip.zero{background:var(--surface-2);color:var(--muted);box-shadow:inset 0 0 0 1px var(--line)}
.tabs{display:flex;gap:2px}
.tabs button{appearance:none;background:none;border:0;border-bottom:3px solid transparent;padding:10px 12px;font-weight:600;color:var(--muted);cursor:pointer;margin-bottom:-1px}
.tabs button[aria-selected="true"]{color:var(--fg);border-bottom-color:var(--accent)}
.tabn{font-family:var(--font-mono);font-size:12px;font-weight:500;margin-left:4px;color:var(--muted)}
main{padding-block:20px}

/* 공통 상자·버튼·폼 */
.box{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px}
.box h2{margin:0 0 12px;font-size:13px;font-weight:600;color:var(--muted)}
.note{margin:10px 0 0;font-size:13px;color:var(--muted)}
.btn{appearance:none;font-weight:600;border:1px solid var(--line);background:var(--surface);color:var(--fg);padding:10px 18px;border-radius:10px;cursor:pointer;min-height:44px}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-fg)}
.btn.small{min-height:36px;padding:6px 12px;font-size:13px}
.btn.danger{color:var(--danger)}
.btn.armed{background:var(--danger);border-color:var(--danger);color:#fff}
.btn:disabled{opacity:.45;cursor:not-allowed}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
input[type="text"],input[type="number"],select,textarea{color:var(--fg);background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:10px 12px;min-width:0;width:100%}
textarea{resize:vertical;font-family:var(--font-mono);font-size:12px}
.field{display:flex;flex-direction:column;gap:6px}
.field label,.lbl{font-size:13px;color:var(--muted)}
.form{display:grid;gap:12px}
.row{display:flex;gap:10px;flex-wrap:wrap}
.check{display:flex;align-items:center;gap:8px;font-size:14px;cursor:pointer}
.check input{width:18px;height:18px;accent-color:var(--accent)}

/* 뽑기 탭 */
.draw-grid{display:grid;gap:20px;grid-template-columns:minmax(0,1fr)}
.side{display:grid;gap:20px;align-content:start;min-width:0}
@media (min-width:780px){.draw-grid{grid-template-columns:minmax(0,1.05fr) minmax(0,1fr)}}
.stage{display:flex;flex-direction:column;align-items:center;gap:14px;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:24px 16px 18px;transition:box-shadow .4s,border-color .4s}
.stage.glow{border-color:var(--gc);box-shadow:0 0 0 1px var(--gc),0 0 44px -6px var(--gc)}
.stage-view{width:100%;display:grid;place-items:center}
.flip{width:min(250px,72%);perspective:1000px}
.flip-in{position:relative;aspect-ratio:3/4;transform-style:preserve-3d;transition:transform .7s cubic-bezier(.3,.7,.2,1)}
.flip.revealed .flip-in{transform:rotateY(180deg)}
.face{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden}
.face.front{transform:rotateY(180deg)}
.face .card{width:100%;height:100%;aspect-ratio:auto}
.cardback{width:100%;height:100%;border-radius:10px;border:3px solid var(--line);background:repeating-linear-gradient(135deg,var(--surface-2) 0 10px,var(--surface) 10px 20px);display:grid;place-items:center}
.cardback span{width:96px;height:96px;border-radius:50%;display:grid;place-items:center;background:var(--accent);color:var(--accent-fg);font-family:var(--font-display);font-size:54px;box-shadow:0 0 0 6px var(--surface),0 0 0 8px var(--accent)}
.flip.shake{animation:shake .5s}
@keyframes shake{0%,100%{transform:none}20%{transform:translateX(-7px) rotate(-2deg)}40%{transform:translateX(7px) rotate(2deg)}60%{transform:translateX(-5px) rotate(-1deg)}80%{transform:translateX(5px) rotate(1deg)}}
.res{display:grid;grid-template-columns:repeat(auto-fill,minmax(88px,1fr));gap:10px;width:100%}
.pop{animation:pop .45s both;animation-delay:var(--d,0ms)}
@keyframes pop{from{opacity:0;transform:translateY(10px) scale(.85)}to{opacity:1;transform:none}}
.result-line{min-height:1.5em;margin:0;text-align:center;font-weight:600;display:flex;gap:8px;align-items:center;justify-content:center;flex-wrap:wrap}
.btns{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;width:100%}
.btns .btn{flex:1 1 130px;max-width:200px}
.hint{margin:0;font-size:13px;color:var(--muted);text-align:center;min-height:1.5em}

/* 카드 */
.card{position:relative;aspect-ratio:3/4;border-radius:10px;border:3px solid var(--gc,var(--line));overflow:hidden;background:var(--surface-2)}
.card.g-SSS,.card.g-Ω{border-color:transparent;background:linear-gradient(var(--surface-2),var(--surface-2)) padding-box,var(--gbg) border-box}
.card img{display:block;width:100%;height:100%;object-fit:cover}
.card .badge{position:absolute;top:6px;left:6px;font-family:var(--font-display);font-size:15px;line-height:1.3;padding:0 8px;border-radius:6px;background:var(--gbg,var(--gc));color:var(--gt)}
.card .nm{position:absolute;left:0;right:0;bottom:0;padding:20px 8px 6px;background:linear-gradient(transparent,rgba(0,0,0,.74));color:#fff;font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.card .cnt,.card .new{position:absolute;top:6px;right:6px;font-family:var(--font-mono);font-size:11px;font-weight:600;padding:1px 6px;border-radius:5px}
.card .cnt{background:rgba(0,0,0,.68);color:#fff}
.card .new{background:var(--accent);color:var(--accent-fg)}
.card.locked img{filter:grayscale(1) brightness(.28) contrast(1.1)}
.card.locked .badge{opacity:.7}
.card.locked .nm{color:rgba(255,255,255,.65)}
.card.foil::after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(115deg,transparent 32%,rgba(255,255,255,.38) 48%,transparent 64%);background-size:260% 100%;animation:sheen 3.4s linear infinite;mix-blend-mode:overlay}
@keyframes sheen{from{background-position:160% 0}to{background-position:-60% 0}}

/* 활동 */
.act{display:grid;gap:8px;padding-block:12px}
.act:first-of-type{padding-top:0}
.act+.act{border-top:1px solid var(--line)}
.act-head{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.act-name{font-weight:700}
.act-per{font-size:13px;color:var(--muted)}
.meter{height:8px;border-radius:99px;background:var(--surface-2);box-shadow:inset 0 0 0 1px var(--line);overflow:hidden}
.meter i{display:block;height:100%;background:var(--accent);border-radius:99px;transition:width .3s}
.act-foot{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.act-foot .mono{font-size:12px;color:var(--muted)}
.stepper{display:inline-flex;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--surface)}
.stepper button{appearance:none;border:0;background:var(--surface-2);color:var(--fg);width:42px;height:42px;font-size:20px;cursor:pointer}
.stepper input{border:0;border-radius:0;width:76px;text-align:center;font-family:var(--font-mono);padding:0}
.sum{display:flex;gap:16px;flex-wrap:wrap;font-size:13px;color:var(--muted);margin-top:4px;padding-top:12px;border-top:1px solid var(--line)}
.sum b{font-family:var(--font-mono);color:var(--fg);font-variant-numeric:tabular-nums}

/* 확률표 */
.prob{list-style:none;margin:0;padding:0;display:grid;gap:8px}
.prow{display:grid;grid-template-columns:48px minmax(0,1fr) 52px 44px;gap:10px;align-items:center}
.prow.phead{font-size:12px;color:var(--muted)}
.prow .pct,.prow .own{font-family:var(--font-mono);font-variant-numeric:tabular-nums;text-align:right;font-size:13px}
.prow .own{color:var(--muted)}
.pbar{height:8px;border-radius:99px;background:var(--surface-2)}
.pbar i{display:block;height:100%;border-radius:99px;background:var(--gbg,var(--gc))}

/* 보관함 */
.inv{display:grid;gap:16px}
.istat{display:grid;gap:12px}
.istat-row{display:flex;gap:32px;flex-wrap:wrap}
.big{font-family:var(--font-display);font-size:34px;line-height:1.1}
.big small{font-size:18px;color:var(--muted)}
.filters{display:flex;flex-wrap:wrap;gap:6px}
.fchip{appearance:none;border:1px solid var(--line);background:var(--surface);color:var(--fg);padding:5px 12px;border-radius:999px;cursor:pointer;font-size:13px;font-weight:600;min-height:34px}
.fchip[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-fg)}
.igrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:10px}
.cardbtn{appearance:none;border:0;background:none;padding:0;cursor:pointer;display:block;width:100%;border-radius:10px;color:inherit;text-align:left}
.cardbtn:disabled{cursor:default}
.cardbtn:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.empty{padding:28px 12px;text-align:center;color:var(--muted);grid-column:1/-1}
.hist{list-style:none;margin:0;padding:0;display:grid;gap:2px}
.hist li{display:grid;grid-template-columns:auto auto minmax(0,1fr);gap:10px;align-items:center;padding-block:7px;border-top:1px solid var(--line);font-size:14px}
.hist li:first-child{border-top:0}
.hist time{font-family:var(--font-mono);font-size:12px;color:var(--muted)}
.hist span.n{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* 관리 */
.admin{display:grid;gap:16px;max-width:680px}
.arow{display:grid;grid-template-columns:48px 56px minmax(0,1fr);gap:10px;align-items:center;padding-block:5px;font-size:14px}
.arow .msg{color:var(--danger);font-size:12px}
.crow{display:grid;grid-template-columns:48px minmax(0,1fr) auto;gap:12px;align-items:center;padding-block:8px;border-top:1px solid var(--line)}
.crow img{width:48px;height:64px;object-fit:cover;border-radius:6px;border:2px solid var(--line)}
.crow .nm{display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-weight:600;min-width:0}

.brow{display:grid;gap:8px;padding-block:10px;border-top:1px solid var(--line)}
.brow:first-child{border-top:0;padding-top:0}
.brow .nm{display:flex;gap:8px;align-items:center;flex-wrap:wrap;font-weight:600}
.bthumbs{display:flex;gap:6px;flex-wrap:wrap}
.bthumbs img{width:48px;height:64px;object-fit:cover;border-radius:6px;border:2px solid var(--line)}
.lb-thumbs{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.lb-th{appearance:none;padding:0;border:2px solid transparent;border-radius:8px;background:none;cursor:pointer;overflow:hidden;width:44px;height:58px}
.lb-th img{display:block;width:100%;height:100%;object-fit:cover}
.lb-th.off img{filter:grayscale(1) brightness(.3)}
.lb-th.on{border-color:var(--on-overlay)}
.lb-th:focus-visible{outline:2px solid var(--on-overlay);outline-offset:2px}

/* 확대 보기, 토스트 */
.lb{position:fixed;inset:0;z-index:30;background:var(--overlay);display:grid;place-items:center;padding:calc(20px + env(safe-area-inset-top,0px)) 20px calc(20px + env(safe-area-inset-bottom,0px))}
.lb-in{width:min(300px,100%);display:grid;gap:12px;justify-items:center;color:var(--on-overlay);text-align:center}
.lb-in .card{width:100%}
.lb-info{margin:0;font-weight:600}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(20px + env(safe-area-inset-bottom,0px));z-index:40;background:var(--fg);color:var(--bg);padding:10px 16px;border-radius:10px;font-size:14px;max-width:calc(100% - 32px)}

@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
.fgrid .cardbtn[aria-pressed="true"]{outline:3px solid var(--accent);outline-offset:2px}
.tray{display:flex;flex-wrap:wrap;gap:6px;min-height:34px;align-items:center}
.tray .fchip{min-height:30px}
.fres{display:grid;justify-items:center;gap:10px;text-align:center}
.fres .card{width:140px}
.fres:empty{display:none}
.fuse{display:grid;gap:14px}
.fuse .row{display:flex;gap:8px;flex-wrap:wrap}
/* 신화합성 연출 */
.myth{position:fixed;inset:0;z-index:50;display:grid;place-items:center;overflow:hidden;background:radial-gradient(circle at 50% 50%,#1b0a45 0%,#07030f 70%);color:#fff;-webkit-user-select:none;user-select:none}
.myth-stage{position:relative;width:min(92vw,420px);height:min(78vh,560px);display:grid;place-items:center}
.myth .orbit{position:absolute;left:50%;top:50%;width:0;height:0;animation:morbit 2s cubic-bezier(.55,0,.9,.5) forwards}
.myth .mc{position:absolute;left:0;top:0;width:0;height:0;transform:rotate(var(--a))}
.myth .mc-in{position:absolute;left:-48px;top:-64px;width:96px;animation:mpull 2s cubic-bezier(.5,0,.9,.4) forwards}
.myth .mc-in .card{box-shadow:0 0 22px 2px #ffd24a}
.myth .ring{position:absolute;left:50%;top:50%;width:260px;height:260px;margin:-130px 0 0 -130px;border-radius:50%;background:conic-gradient(from 0deg,#7a2cff,#ff3d86,#ffd24a,#4cc9ff,#7a2cff);-webkit-mask:radial-gradient(circle,transparent 58%,#000 60%,#000 64%,transparent 66%);mask:radial-gradient(circle,transparent 58%,#000 60%,#000 64%,transparent 66%);filter:blur(1px) drop-shadow(0 0 14px #9b4dff);animation:mring 2s ease-in forwards}
.myth .flash{position:absolute;inset:0;background:#fff;opacity:0;pointer-events:none}
.myth.p2 .flash{animation:mflash .7s ease-out forwards}
.myth.p2 .myth-stage{animation:shake .5s}
.myth .rays{position:absolute;left:50%;top:50%;width:160vmax;height:160vmax;margin:-80vmax 0 0 -80vmax;background:repeating-conic-gradient(from 0deg,rgba(255,210,74,.34) 0 6deg,rgba(255,61,134,0) 6deg 18deg);-webkit-mask:radial-gradient(circle,#000 0,transparent 48%);mask:radial-gradient(circle,#000 0,transparent 48%);opacity:0}
.myth.p3 .rays{opacity:1;animation:mrays 14s linear infinite,mfade 1s ease-out}
.myth .spark{position:absolute;left:50%;top:50%;width:8px;height:8px;margin:-4px;border-radius:50%;background:var(--c,#ffd24a);box-shadow:0 0 10px 2px var(--c,#ffd24a);opacity:0}
.myth.p3 .spark{animation:mspark 1.3s ease-out var(--d,0s) forwards}
.myth .mres{position:relative;display:grid;justify-items:center;gap:14px;opacity:0;transform:scale(.2) rotateY(180deg);width:auto;text-align:center}
.myth.p3 .mres{animation:mreveal 1s cubic-bezier(.2,1.2,.3,1) .1s forwards}
.myth .mres .card{width:min(52vw,230px);box-shadow:0 0 0 2px #fff4,0 0 60px 10px #9b4dff,0 0 120px 30px #ff3d8666}
.myth .title{font-family:var(--font-display);font-size:clamp(28px,8vw,42px);letter-spacing:.12em;background:linear-gradient(90deg,#7a2cff,#ff3d86,#ffd24a,#4cc9ff);-webkit-background-clip:text;background-clip:text;color:transparent;filter:drop-shadow(0 0 12px #9b4dff)}
.myth .sub{font-size:15px;font-weight:600;color:#f1e9ff}
.myth .hintm{position:absolute;bottom:18px;left:0;right:0;text-align:center;font-size:12px;color:#fff9}
.myth.p3 .hintm{display:none}
.myth .btn{position:absolute;bottom:calc(22px + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%);min-width:120px}
.myth.p2 .orbit,.myth.p2 .ring,.myth.p3 .orbit,.myth.p3 .ring{display:none}
@keyframes morbit{from{transform:rotate(0)}to{transform:rotate(900deg)}}
@keyframes mpull{from{transform:translateY(-150px) scale(1)}85%{opacity:1}to{transform:translateY(0) scale(.3);opacity:.2}}
@keyframes mring{from{transform:scale(.5) rotate(0);opacity:0}25%{opacity:1}to{transform:scale(1.15) rotate(720deg);opacity:1}}
@keyframes mflash{0%{opacity:0}18%{opacity:1}100%{opacity:0}}
@keyframes mrays{to{transform:rotate(360deg)}}
@keyframes mfade{from{opacity:0}}
@keyframes mspark{0%{opacity:1;transform:rotate(var(--ang)) translateX(0) scale(1)}100%{opacity:0;transform:rotate(var(--ang)) translateX(var(--dist)) scale(.2)}}
@keyframes mreveal{to{opacity:1;transform:none}}
</style>

<div class="app">
  <div class="bar">
