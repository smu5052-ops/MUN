const GI={};GRADES.forEach((g,i)=>{GI[g.k]=i});
function rint(n){
  const lim=4294967296-(4294967296%n);
  const a=new Uint32Array(1);let x;
  do{crypto.getRandomValues(a);x=a[0]}while(x>=lim);
  return x%n;
}
function pickGradeIndex(has){
  const r=rint(1000);let acc=0,idx=GRADES.length-1;
  for(let i=0;i<GRADES.length;i++){acc+=GRADES[i].p;if(r<acc){idx=i;break}}
  if(has[GRADES[idx].k])return idx;
  for(let d=1;d<GRADES.length;d++){
    if(idx-d>=0&&has[GRADES[idx-d].k])return idx-d;
    if(idx+d<GRADES.length&&has[GRADES[idx+d].k])return idx+d;
  }
  return idx;
}
function earnedTickets(posts,comments){return Math.floor(posts/10)+Math.floor(comments/20)}
