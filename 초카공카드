const $=s=>document.querySelector(s);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
const reduce=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;

/* 저장 */
const KEY='gallery-card-gacha.v2';
function lsGet(k){try{return localStorage.getItem(k)}catch(e){return null}}
function lsSet(k,v){try{localStorage.setItem(k,v);return true}catch(e){return false}}
function jparse(s,d){try{const v=JSON.parse(s);return v&&typeof v==='object'?v:d}catch(e){return d}}
/* inv/vars/lastv의 키는 '캐릭터id:등급' */
const newPid=()=>String(rint(100000000)).padStart(8,'0');
const TEN_CD=30000;
const D=()=>({pid:newPid(),ten:0,used:0,inv:{},vars:{},lastv:{},hist:[]});
function fix(s){
  s.used=Math.max(0,Math.floor(Number(s.used)||0));
  s.ten=Number(s.ten)>0&&Number(s.ten)<=Date.now()+TEN_CD?Number(s.ten):0;
  if(!/^\d{8}$/.test(String(s.pid)))s.pid=newPid();
  ['inv','vars','lastv'].forEach(k=>{if(!s[k]||typeof s[k]!=='object'||Array.isArray(s[k]))s[k]={}});
  if(!Array.isArray(s.hist))s.hist=[];
  return s;
}
let S=fix(Object.assign(D(),jparse(lsGet(KEY),{})));
const save=()=>lsSet(KEY,JSON.stringify(S));
save();

/* 캐릭터 풀 */
const pool=()=>CHARACTERS;
/* Ω 전용 캐릭터는 항목에 omega:true 를 붙입니다. 이들은 Ω 등급만, 나머지 캐릭터는 Ω를 뺀 등급만 가집니다. */
const TOPG=GRADES[GRADES.length-1].k;
const omegaPool=()=>CHARACTERS.filter(c=>c.omega);
const normalPool=()=>CHARACTERS.filter(c=>!c.omega);
const validG=(c,g)=>c.omega?g===TOPG:g!==TOPG;
const slotTotal=()=>CHARACTERS.reduce((a,c)=>a+GRADES.filter(g=>validG(c,g.k)).length,0);
const ownedSlots=()=>CHARACTERS.reduce((a,c)=>a+GRADES.filter(g=>validG(c,g.k)&&S.inv[c.id+':'+g.k]>0).length,0);

/* 샘플 카드 그림 */
const artCache={};
function hash(s){let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return h>>>0}
function art(ch){
  if(artCache[ch.id])return artCache[ch.id];
  const h=hash(ch.id),hue=h%360,cx=150+((h%7)-3)*5;
  const svg=`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 400"><defs><linearGradient id="a" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="hsl(${hue},45%,55%)"/><stop offset="1" stop-color="hsl(${(hue+40)%360},45%,28%)"/></linearGradient></defs><rect width="300" height="400" fill="url(#a)"/><circle cx="${cx}" cy="165" r="44" fill="#fff" fill-opacity=".9"/><path d="M${cx-95} 400C${cx-95} 270 ${cx-50} 225 ${cx} 225S${cx+95} 270 ${cx+95} 400Z" fill="#fff" fill-opacity=".9"/></svg>`;
  return artCache[ch.id]='data:image/svg+xml;charset=utf-8,'+encodeURIComponent(svg);
}
const imgsOf=ch=>ch.imgs&&ch.imgs.length?ch.imgs:(ch.img?[ch.img]:[]);
function pic(ch,v){const a=imgsOf(ch);return a.length?a[Math.min(v||0,a.length-1)]:art(ch)}
function cardHTML(ch,o){
  o=o||{};
  const count=o.count||0,locked=!!o.locked,isNew=!!o.isNew,newV=!!o.newV;
  const foil=!locked&&GI[o.g]>=8?' foil':'';
  const tag=isNew?'<span class="new">NEW</span>':newV?'<span class="new">새 컷</span>':(count>1?`<span class="cnt">×${count}</span>`:'');
  return `<div class="card g-${o.g}${foil}${locked?' locked':''}"><img src="${locked&&ch.omega?art(ch):pic(ch,o.v)}" alt="" draggable="false"><span class="badge">${o.g}</span>${tag}<span class="nm">${locked?'???':esc(ch.name)}</span></div>`;
}

/* 보관함 한도 */
const CAP=5000;
const totalCards=()=>Object.keys(S.inv).reduce((a,k)=>a+(S.inv[k]||0),0);
function giveCard(ch,g){
  const key=ch.id+':'+g,nv=imgsOf(ch).length,v=nv>1?rint(nv):0;
  const isNew=!S.inv[key],vm=S.vars[key]||(S.vars[key]={});
  const newV=!isNew&&nv>1&&!vm[v];
  vm[v]=(vm[v]||0)+1;S.lastv[key]=v;S.inv[key]=(S.inv[key]||0)+1;
  return {ch,g,key,isNew,newV,v};
}
function takeCards(key,n){
  const vm=S.vars[key]||{};
  for(let i=0;i<n;i++){
    const ks=Object.keys(vm).filter(x=>vm[x]>0);
    let tot=ks.reduce((a,x)=>a+vm[x],0);if(!tot)break;
    let r=rint(tot),pick=ks[0];
    for(const x of ks){if(r<vm[x]){pick=x;break}r-=vm[x]}
    vm[pick]--;if(!vm[pick])delete vm[pick];
    S.inv[key]=(S.inv[key]||0)-1;
  }
  if(!(S.inv[key]>0)){delete S.inv[key];delete S.vars[key];delete S.lastv[key]}
  else if(!vm[S.lastv[key]])S.lastv[key]=Number(Object.keys(vm)[0]||0);
}

/* 뽑기 */
let busy=false;
const ALLG={};GRADES.forEach(g=>{ALLG[g.k]=true});
function roll(n){
  if(!pool().length)return null;
  const out=[];
  for(let i=0;i<n;i++){
    let g=GRADES[pickGradeIndex(ALLG)].k;
    if(g===TOPG&&!omegaPool().length)g=GRADES[GRADES.length-2].k;
    const list=g===TOPG?omegaPool():normalPool();
    const ch=list[rint(list.length)],key=ch.id+':'+g;
    const nv=imgsOf(ch).length,v=nv>1?rint(nv):0;
    const isNew=!S.inv[key];
    const vm=S.vars[key]||(S.vars[key]={});
    const newV=!isNew&&nv>1&&!vm[v];
    vm[v]=(vm[v]||0)+1;S.lastv[key]=v;
    S.inv[key]=(S.inv[key]||0)+1;
    S.used++;
    S.hist.unshift({id:ch.id,name:ch.name,g,t:Date.now(),v});
    out.push({ch,g,key,isNew,newV,v});
  }
  S.hist=S.hist.slice(0,60);
  if(!save())toast('이 브라우저에 저장하지 못했어요');
  return out;
}
const coverHTML=()=>`<div class="flip" id="flip"><div class="flip-in"><div class="face"><div class="cardback"><span>?</span></div></div><div class="face front"></div></div></div>`;

async function run(n){
  if(busy)return;
  if(totalCards()+n>CAP){toast('보관함이 가득 찼어요. 합성으로 카드를 줄여보세요');renderStatus();return}
  busy=true;
  const out=roll(n);
  if(!out){busy=false;renderStatus();return}
  renderStatus();
  const stage=$('#stage'),line=$('#resultLine');
  stage.className='stage';line.innerHTML='';
  const best=out.reduce((m,r)=>Math.max(m,GI[r.g]),0);
  const cls='stage g-'+GRADES[best].k+(best>=7?' glow':'');
  if(n===1){
    $('#stageView').innerHTML=coverHTML();
    const flip=$('#flip');
