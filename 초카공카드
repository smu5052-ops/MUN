$('#loadBtn').addEventListener('click',()=>{
  try{
    const imp=importCode($('#loadCode').value);
    if(Object.keys(imp.inv).reduce((a,k)=>a+imp.inv[k],0)>CAP){toast('카드가 '+CAP+'장을 넘는 코드예요');return}
    S=fix(Object.assign(D(),imp,{ten:S.ten,pid:imp.pid&&imp.pid.length===8?imp.pid:S.pid}));
    save();syncInputs();$('#loadCode').value='';
    $('#stageView').innerHTML=coverHTML();$('#resultLine').innerHTML='';$('#stage').className='stage';
    renderStatus();renderProb();renderAdmin();toast('불러왔어요');
  }catch(e){toast('코드를 읽을 수 없어요. 다시 확인하세요')}
});
$('#resetBtn').addEventListener('click',e=>{
  armed(e.currentTarget,'한 번 더 누르면 초기화',()=>{
    S=fix(Object.assign(D(),{ten:S.ten,pid:S.pid}));
    save();syncInputs();
    $('#stageView').innerHTML=coverHTML();$('#resultLine').innerHTML='';$('#stage').className='stage';
    renderStatus();renderProb();renderAdmin();toast('초기화했어요');
  });
});

/* 알림 */
let tt;
function toast(m){const t=$('#toast');t.textContent=m;t.hidden=false;clearTimeout(tt);tt=setTimeout(()=>{t.hidden=true},2600)}

/* 시작 */
syncInputs();
$('#stageView').innerHTML=coverHTML();
renderStatus();
renderProb();
</script>

